# Copy to `.env.local` for local dev, or `.env.production` for production builds.
# The app resolves the API URL as: VITE_SYNCRA_API_URL -> window.SYNCRA_API (from
# public/config/config.js) -> http://localhost:3000/api
# Leave unset to fall back to the public/config/config.js runtime value.
VITE_SYNCRA_API_URL=http://localhost:3000/api
